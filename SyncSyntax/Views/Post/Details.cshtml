@model Post


<style>
    .content-wrapper {
        padding: 20px;
        max-width: 1000px;
        margin: 0 auto;
        font-family: sans-serif;
    }

    .Feature-image {
        width: 100%;
        height: 500Px;
        object-fit: cover;
        margin-bottom: 20px;
        border-radius: 8px;
    }
</style>
@if (User.IsInRole("Admin"))
{
    <div class="text-end">
        <a class=" btn btn-secondary my-3" asp-action="Edits" asp-controller="Post" asp-route-id="@Model.Id"> Edit Post</a>
        <a class="btn btn-danger mx-3 my-3" asp-action="Delete" asp-controller="Post" asp-route-id="@Model.Id"> Delete Post</a>
    </div>
}
<div class="content-wrapper">
    <h1>@Model.Title</h1>
    <p>
        <span class=" badge bg-primary">By </span> @Model.Author|<span class="badge bg-primary">
            Published on
        </span>@Model.PublishedDate.ToString("MMM dd, yyyy")
    </p>
    <p><span class="badge bg-secondary">Category</span> @Model.Category.Name</p>
    <img src="@Model.FutureImageURL" alt="@Model.Title" class="Feature-image" />
    <hr />
    <div>
        @Html.Raw(Model.Content)
    </div>
    <hr />
    @if (Model.Comments.Any())
    {
        <div id="commentSection">
            @foreach(var comment in Model.Comments)
            {
                <div class="card mb-3 shadow-sm ">
                    <div class="card-body">
                        <h5 class="card-title">@comment.UserName</h5>
                        <p class="card-text text-muted">| Published Date @comment.CommentDate.ToString("MMMM dd ,yyyy") </p>
                        <p class="card-text">@comment.Content</p>
                    </div>
    
                </div>
            }
        </div>
    }
    else
    {
        <p>No Comments yet </p>
    }

    @if (User.Identity.IsAuthenticated)
    {
        <div>Comment To Post</div>
        <form >
            <div class="form-group ">
                <label for="UserName">Name</label>
                <input for="Username" id="Username" name="Username" class="form-control" required />
            </div>
            <div class="form-group ">
                <label for="Content">Content</label>
                <input for="Content" id="Content" name="Content" class="form-control" required />
            </div>
            
            <button type="submit" class="btn btn-primary mt-2 rounded">Submit Comment</button>
        </form>
    }
   

</div>
@section Scripts {
    <script>
        $(document).ready(function() {
            $('#commentform').submit(function(e) {
                e.preventDefault();
                var userName = $('#UserName').val();
                var content = $('#Content').val();
                var postId = '@Model.Id';
                
                $.ajax({
                    url:' @Url.Action("AddComment", "Post")',
                    type: 'POST',
                    contentType: 'application/json',
                    data:JSON.stringify({
                        Username: userName,
                        Content: content,
                        PostId: postId
                    }),
                    success: function(response) {
                     $('#commentform')[0].reset();
                     $('#commentSection').append(
                        `<div class="card mb-3 shadow-sm ">
                            <div class="card-body">
                            <h4 class="card-title"> ${response.username}</h4
                                <p class="card-text">${response.commentdate} </p>                                
                                <p class="card-text">${response.content} </p>
                             </div>
                        </div>
                              ` );
                     }

                       
                 });
            });

        });
    </script>
}